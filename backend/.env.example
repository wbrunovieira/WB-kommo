NODE_ENV=development
PORT=3001

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=wb_kommo_db
POSTGRES_TEST_DB=wb_kommo_test

DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/wb_kommo_db?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Minimum 32 characters — generate with: openssl rand -hex 32
SESSION_JWT_SECRET=replace-with-min-32-chars-random-string

# ─── App ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
STORAGE_TYPE=local

# ─── Seed ─────────────────────────────────────────────────────────────────────
SEED_RESELLER_NAME=Your Name
SEED_RESELLER_EMAIL=your@email.com
SEED_RESELLER_PASSWORD=YourPassword123@
